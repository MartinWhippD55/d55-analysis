# Programme manifest — the single source of truth for a programme.
# Dimension names are the JOIN KEY to each module's `dimensions_covered` and to
# assessment scores; keep them byte-identical across artefacts.
programme:
  slug: {{slug}}
  name: "{{name}}"
  external_name: null              # customer-facing name (may differ; often TBD)
  one_liner: "{{one_liner}}"
  phases: [Assess, Teach, Prove, Scale]
  commercial:
    free_assessment: true
    tiers: [Assess, "Assess+Teach", "Full programme"]
brand:
  primary: "{{brand_primary}}"
  logo: assets/brand/d55-logo-white.png
  background: assets/brand/d55-background.jpg
dimensions: []                     # list of { name, short, rubric_ref }
modules: []                        # mirrors module.md frontmatter for fast consumption
