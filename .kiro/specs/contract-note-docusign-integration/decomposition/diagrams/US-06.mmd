  COMP -->|"download signed"| DS
  COMP -->|"upload signed doc"| SF
  COMP -->|"get + update status"| MD
  COMP -->|"store signed PDF"| U01
  DECL -->|"error bucket"| U01

  classDef build fill:#eef4ff,stroke:#4066b3,color:#16324f;
  classDef use fill:#f4f6f8,stroke:#8a94a6,color:#2b3440;
