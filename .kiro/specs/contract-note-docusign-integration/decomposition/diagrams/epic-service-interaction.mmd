%% Epic SQP-5045 — DocuSign integration service interaction
%% Runtime flow render -> send -> sign -> webhook -> store.
%% Each participant annotated with the delivering story (US-xx / SQP key).
flowchart LR
  R["Render pipeline<br/>Estimate&nbsp;1 + metadata passthrough<br/><b>US-07 / SQP-5052</b>"]
  SE["SendEnvelope Lambda<br/><b>US-05 / SQP-5050</b>"]
  SF["Salesforce client<br/><b>US-02 / SQP-5047</b>"]
  DS["DocuSign client<br/><b>US-03 / SQP-5048</b>"]
  WH["Webhook Lambda<br/><b>US-06 / SQP-5051</b>"]
  C(("Customer"))

  subgraph FDN["Foundation — US-01 / SQP-5046"]
    MD[("Envelope metadata<br/>DynamoDB + GSI")]
    S3[("signed-contract-notes<br/>S3 bucket")]
    ERR[("error bucket<br/>reused · docusign/ prefix")]
  end

  R -->|"contract PDF + Contract_Metadata"| SE
  SE -->|"lookup contact"| SF
  SE -->|"create envelope"| DS
  SE -->|"store record"| MD
  DS -->|"email for signature"| C
  C -->|"Connect callback"| WH
  WH -->|"validate HMAC / download signed"| DS
  WH -->|"store signed PDF"| S3
  WH -->|"upload signed doc"| SF
  WH -->|"update status"| MD
  WH -->|"declined / expired / failure"| ERR

  classDef fdn fill:#eef4ff,stroke:#4066b3,color:#16324f;
  classDef store fill:#f4f6f8,stroke:#8a94a6,color:#2b3440;
  class MD,S3,ERR store;

